# --- AHRS and Extended Kalman Filter Settings ---
AHRS_ORIENTATION 8
AHRS_EKF_TYPE    3

# Assign PWM channels 1 through 8 to ArduSub Motor functions (33 to 40)
SERVO1_FUNCTION 33
SERVO2_FUNCTION 34
SERVO3_FUNCTION 35
SERVO4_FUNCTION 36
SERVO5_FUNCTION 37
SERVO6_FUNCTION 38
SERVO7_FUNCTION 39
SERVO8_FUNCTION 40

# Set default frame configuration to Vectored
FRAME_CONFIG 2

# Disable the safety switch requirement by default (useful if no physical button is wired)
# BRD_SAFETYENABLE 0

# --- ESC Protocol Selection ---
# 6 = DShot600 (High-speed digital protocol)
MOT_PWM_TYPE 6

# --- Relay configuration section ---
RELAY1_PIN 80
RELAY1_DEFAULT 1